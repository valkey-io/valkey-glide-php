<?xml version="1.0"?>
<ruleset name="ValkeyGlide">
    <description>PHP CodeSniffer configuration for Valkey GLIDE PHP</description>
    
    <!-- Check all PHP files. -->
    <file>./</file>
    <arg name="extensions" value="php"/>
    
    <!-- Exclude vendor, build, submodule, and auto-generated test runner files -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>run-tests.php</exclude-pattern>
    
    <!-- Use PSR-12 standard -->
    <rule ref="PSR12"/>
    
    <!-- Additional rules -->
    <rule ref="Generic.Arrays.DisallowLongArraySyntax"/>
    
    <!-- Customize line length -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="200"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>
    
    <!-- Allow underscores in test method names -->
    <rule ref="PSR1.Methods.CamelCapsMethodName.NotCamelCaps">
        <exclude-pattern>tests/*</exclude-pattern>
        <exclude-pattern>*.stub.php</exclude-pattern>
    </rule>
    
    <!-- Relax strict types requirement for certain files -->
    <rule ref="Generic.PHP.RequireStrictTypes">
        <exclude-pattern>tests/*</exclude-pattern>
        <exclude-pattern>examples/*</exclude-pattern>
        <exclude-pattern>*.stub.php</exclude-pattern>
    </rule>
    
    <!-- Relax class declaration rules for tests and stubs -->
    <rule ref="PSR1.Classes.ClassDeclaration">
        <exclude-pattern>tests/*</exclude-pattern>
        <exclude-pattern>*.stub.php</exclude-pattern>
    </rule>
</ruleset>
